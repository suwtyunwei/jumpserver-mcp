# JumpServer 地址（只需 host，不要带 /api/v1）
JUMPSERVER_URL=https://jumpserver.example.com

# 推荐：Access Key（永久有效，HTTP Signature 签名）
ACCESS_KEY_ID=
ACCESS_KEY_SECRET=

# 或者：临时 Bearer Token（约 1 天有效；AK/SK 优先）
API_TOKEN=

# 自签名证书时保持 false；生产内网可改 true
VERIFY_SSL=false
HTTP_TIMEOUT=60

# MCP 端点自身的门禁（可选）
# 推荐用独立 header，避免和传给 JumpServer 的 Authorization 冲突
GATEWAY_KEY=
# 旧版行为：要求 MCP 请求的 Authorization: Bearer <value>
API_KEY=

# SSE 挂载路径与端口
BASE_PATH=/sse
SERVER_PORT=8099

# 工具白名单：curated（默认，约 47 个）| common | security | all
TOOLSET_PRESET=curated

# 常用类工具默认只读，改成 true 可放开 POST/PUT/PATCH
ALLOW_COMMON_WRITES=false
# DELETE 默认全部禁用
ALLOW_DESTRUCTIVE_TOOLS=false
# settings/setting 的 PATCH 默认禁用
ALLOW_SETTINGS_WRITE=false

# 追加自定义工具：路径正则=方法;路径正则=方法
# TOOLSET_EXTRA_RULES=/api/v1/tickets/tickets/=get;/api/v1/tickets/tickets/{id}/=get
# 排除路径（逗号分隔的正则）
# TOOLSET_EXCLUDE_PATHS=/api/v1/audits/

# 返回体截断长度，0 表示不截断
MAX_RESPONSE_CHARS=20000
LOG_LEVEL=INFO
